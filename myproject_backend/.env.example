DEBUG=True
SECRET_KEY=your-secret-key-here

# ── Database ──────────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=examguard_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Email ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ExamGuard <noreply@examguard.com>

# ── Redis (Celery broker + Django Channels) ───────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1

# ── RunPod AI Engine (Phase 4–5) ──────────────────────────────────
# Get this from your RunPod endpoint dashboard after deploying the worker
RUNPOD_ENDPOINT=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/runsync

# ── Django → RunPod dispatcher auth (Phase 5) ─────────────────────
# Base URL of this Django backend (used by the dispatcher to POST alerts back)
DJANGO_API_URL=https://your-backend.com/api
# A DRF Token for the service account that creates alerts
DJANGO_API_TOKEN=your_service_token_here

# ── AI Detection tuning ───────────────────────────────────────────
ALERT_CONFIDENCE_THRESHOLD=0.6
FRAME_JPEG_QUALITY=85
FRAME_SAMPLE_RATE=2